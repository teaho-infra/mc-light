{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "conda run -n mc-light --no-capture-output python3 /home/leonbook5/IdeaProjects/agentspace/mc-light/host/mc_light.py on" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          { "type": "command", "command": "conda run -n mc-light --no-capture-output python3 /home/leonbook5/IdeaProjects/agentspace/mc-light/host/mc_light.py wait" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "conda run -n mc-light --no-capture-output python3 /home/leonbook5/IdeaProjects/agentspace/mc-light/host/mc_light.py on" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "conda run -n mc-light --no-capture-output python3 /home/leonbook5/IdeaProjects/agentspace/mc-light/host/mc_light.py off" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "conda run -n mc-light --no-capture-output python3 /home/leonbook5/IdeaProjects/agentspace/mc-light/host/mc_light.py off" }
        ]
      }
    ]
  }
}
